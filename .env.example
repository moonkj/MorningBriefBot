# === GitHub Pages (image hosting for Instagram / TikTok) ===
# https://<GITHUB_USERNAME>.github.io/<GITHUB_REPO>/
GITHUB_USERNAME=your-github-username
GITHUB_REPO=MorningBriefBot

# === Instagram (Meta Graph API) ===
# Meta Developer 앱 (developers.facebook.com) 에서 발급
META_APP_ID=
META_APP_SECRET=
# IG_USER_ID: Instagram Business/Creator account's numeric ID (Graph API Explorer -> GET /me/accounts -> instagram_business_account)
# IG_ACCESS_TOKEN: long-lived Page access token with instagram_basic + instagram_content_publish
IG_USER_ID=
IG_ACCESS_TOKEN=

# === TikTok (Content Posting API) ===
# TikTok Developer 콘솔의 앱에서 발급 (scripts/tiktok_oauth.py 실행 전에 필요)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# scripts/tiktok_oauth.py 실행 후 발급되는 값
TIKTOK_ACCESS_TOKEN=
# unaudited apps can only publish as SELF_ONLY (private/draft) until app review is approved
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# === Brand ===
BRAND_HANDLE=@your_handle
